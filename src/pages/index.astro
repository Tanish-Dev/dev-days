---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoryOptions = [...new Map(
  games
    .filter((game) => game.category !== null)
    .map((game) => [game.category!.id, game.category!.name]),
).entries()].sort(([, a], [, b]) => a.localeCompare(b));
const publisherOptions = [...new Map(
  games
    .filter((game) => game.publisher !== null)
    .map((game) => [game.publisher!.id, game.publisher!.name]),
).entries()].sort(([, a], [, b]) => a.localeCompare(b));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="flex flex-col gap-4 mb-6 sm:flex-row sm:items-end sm:justify-between">
        <h2 class="text-2xl font-medium text-slate-100">Featured Games</h2>
        {games.length > 0 && (
          <div class="flex flex-wrap items-end gap-4" data-testid="game-filters">
            <fieldset>
              <legend class="block mb-2 text-sm font-medium text-slate-200">Categories</legend>
              <div class="flex flex-wrap gap-3">
                {categoryOptions.map(([id, name]) => (
                  <label class="flex items-center gap-2 text-sm text-slate-300">
                    <input
                      type="checkbox"
                      value={id}
                      class="h-4 w-4 rounded border-slate-600 bg-slate-800 text-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                      data-testid={`category-filter-${id}`}
                    />
                    {name}
                  </label>
                ))}
              </div>
            </fieldset>
            <label class="text-sm text-slate-200">
              <span class="block mb-2 font-medium">Publisher</span>
              <select
                class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="publisher-filter"
              >
                <option value="">All publishers</option>
                {publisherOptions.map(([id, name]) => <option value={id}>{name}</option>)}
              </select>
            </label>
            <button
              type="button"
              class="rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="reset-filters"
            >
              Clear filters
            </button>
          </div>
        )}
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div>
          <p class="mb-4 text-sm text-slate-400" role="status" aria-live="polite" data-testid="filter-result-count">
            Showing {games.length} games
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
          </div>
          <nav class="mt-8 flex items-center justify-center gap-4" aria-label="Game list pagination" data-testid="game-pagination">
            <button
              type="button"
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-40"
              data-testid="pagination-previous"
              aria-label="Previous page"
            >
              Previous
            </button>
            <span class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="pagination-status"></span>
            <button
              type="button"
              class="rounded-lg border border-slate-600 px-4 py-2 text-sm text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none disabled:cursor-not-allowed disabled:opacity-40"
              data-testid="pagination-next"
              aria-label="Next page"
            >
              Next
            </button>
          </nav>
          <div class="hidden" data-testid="filtered-empty-state">
            <EmptyState text="No games match your selected filters." />
          </div>
        </div>
      )}
    </div>
  </div>
</Layout>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const categoryFilters = [...document.querySelectorAll<HTMLInputElement>('[data-testid^="category-filter-"]')];
  const publisherFilter = document.querySelector<HTMLSelectElement>('[data-testid="publisher-filter"]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-testid="reset-filters"]');
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const pagination = document.querySelector<HTMLElement>('[data-testid="game-pagination"]');
  const previousButton = document.querySelector<HTMLButtonElement>('[data-testid="pagination-previous"]');
  const nextButton = document.querySelector<HTMLButtonElement>('[data-testid="pagination-next"]');
  const paginationStatus = document.querySelector<HTMLElement>('[data-testid="pagination-status"]');
  const pageSize = 6;
  let currentPage = 1;

  function updateFilters(): void {
    const selectedCategories = categoryFilters
      .filter((filter) => filter.checked)
      .map((filter) => filter.value);
    const selectedPublisher = publisherFilter?.value ?? '';
    const matchingCards = cards.filter((card) => {
      const categoryMatches =
        selectedCategories.length === 0 || selectedCategories.includes(card.dataset.categoryId ?? '');
      const publisherMatches =
        selectedPublisher === '' || card.dataset.publisherId === selectedPublisher;
      return categoryMatches && publisherMatches;
    });
    const pageCount = Math.max(1, Math.ceil(matchingCards.length / pageSize));
    currentPage = Math.min(currentPage, pageCount);
    const pageStart = (currentPage - 1) * pageSize;

    cards.forEach((card) => {
      const isVisible = matchingCards.indexOf(card) >= pageStart && matchingCards.indexOf(card) < pageStart + pageSize;
      card.hidden = !isVisible;
    });

    if (resultCount) resultCount.textContent = `Showing ${matchingCards.length} games`;
    if (emptyState) emptyState.classList.toggle('hidden', matchingCards.length > 0);
    if (paginationStatus) paginationStatus.textContent = `Page ${currentPage} of ${pageCount}`;
    if (previousButton) previousButton.disabled = currentPage === 1;
    if (nextButton) nextButton.disabled = currentPage === pageCount;
    if (pagination) pagination.hidden = pageCount === 1;
  }

  categoryFilters.forEach((filter) => filter.addEventListener('change', () => {
    currentPage = 1;
    updateFilters();
  }));
  publisherFilter?.addEventListener('change', () => {
    currentPage = 1;
    updateFilters();
  });
  previousButton?.addEventListener('click', () => {
    currentPage -= 1;
    updateFilters();
  });
  nextButton?.addEventListener('click', () => {
    currentPage += 1;
    updateFilters();
  });
  resetButton?.addEventListener('click', () => {
    categoryFilters.forEach((filter) => {
      filter.checked = false;
    });
    if (publisherFilter) publisherFilter.value = '';
    currentPage = 1;
    updateFilters();
  });

  updateFilters();
</script>
